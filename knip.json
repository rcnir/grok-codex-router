{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "bin/*.ts",
    "control/server.ts",
    "control/telemetry-check.ts",
    "scripts/*.ts",
    "tests/**/*.test.ts",
    "src/config.ts",
    "src/pilot-policy.ts",
    "src/runtime-client.ts",
    "src/turn-execution.ts",
    "src/transport.ts",
